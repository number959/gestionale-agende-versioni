+<span class="turno{% if v.categoria in ('ASSENZA', 'RIPOSO') %} senza-orario{% endif %}{% if v.categoria == 'REPERIBILITA' %} reperibile{% endif %}{% if not v.codice %} a-mano{% endif %}{% if v.diverso %} diverso{% endif %}{% if v.codice and v.codice|length > 2 %} lungo-{{ [v.codice|length, 4]|min }}{% endif %}{% if c.turni|length > 1 %} doppio{% endif %}" style=…

