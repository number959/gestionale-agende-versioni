+    parti = urlsplit(indirizzo or '')
+    if parti.scheme or parti.netloc:
+        return None
+    try:
+        endpoint, _ = current_app.url_map.bind('x').match(parti.path, method=metodo)
+    except HTTPException:
+        return None
+    return area_di(endpoint)
